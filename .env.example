# Ardea settings. Copy to .env and fill in.
#
# Only the database password and the HTTPS address (ARDEA_SITE_ADDRESS) are needed here. Everything that is
# commented out below (# NAME=value) can instead be set by an admin on the Settings page of the web UI.
# Uncomment a line to set it here instead: a value in .env always wins and shows read-only on the Settings page.
# NOTE: put comments on their OWN line. Docker Compose reads `KEY=   # comment` as the value "# comment".
# (The code ignores values starting with "#", but other characters after a value are kept.)

# Timezone (log timestamps; DB stores UTC)
TZ=Asia/Nicosia

# Database. POSTGRES_HOST/PORT are set by docker-compose (db:5432)
POSTGRES_DB=ArdeaDB
POSTGRES_USER=admin
POSTGRES_PASSWORD=changeme

# Service intervals (seconds)
# FETCH_INTERVAL_SECONDS=180
WORKER_POLL_SECONDS=5

# ---------------------------------------------------------------- LLM
# e.g. http://host.docker.internal:11434 if Ollama runs on this host
# LLM_URL=YOUR_LLM_URL
# CPU-only: qwen3:30b-a3b-instruct-2507-q4_K_M (MoE, 3B active) is the best speed/quality trade-off
# LLM_MODEL=qwen3:14b
# CPU-only: 16384. Bigger = slower prompt reads; changing it reloads the model.
# LLM_NUM_CTX=24576
LLM_NUM_PREDICT=2048
# Empty = don't send (models without thinking, e.g. *-instruct-2507, qwen2.5).
# false = off (hybrid qwen3 thinks by default: very slow on CPU). true = on. gpt-oss: low|medium|high
# LLM_THINK=
# Fixed seed: same alert -> same verdict
LLM_SEED=42
# Keep the model loaded: -1 = forever, or e.g. 24h
# LLM_KEEP_ALIVE=-1
# 0 = Ollama default. On 2 CPU sockets, benchmark physical cores of one socket vs both.
# LLM_NUM_THREAD=0

# Agent budgets. CPU-only inference needs the generous values below.
# LLM_TIMEOUT_SECONDS=900
# AGENT_MAX_STEPS=8
# AGENT_MAX_TOOL_CALLS=10
# AGENT_MAX_WALL_SECONDS=1200
# Must exceed AGENT_MAX_WALL_SECONDS
WORKER_LEASE_MINUTES=40

# Verdict policy. FP/BP below MIN_CONFIDENCE_TO_CLOSE -> Needs Human Review.
# MIN_CONFIDENCE_TO_CLOSE=70
# Adversarial second look before any FP/BP auto-close
# VERIFY_CLOSURES=true
# Analyst verdicts on similar alerts shown to the model (0 = off)
# FEEDBACK_EXAMPLES=3

# ---------------------------------------------------------------- Edition (README "Editions")
# Empty = Community (free). A Pro or MSP licence key from your purchase e-mail.
# The worker checks it once a day at api.lemonsqueezy.com; only the key is sent, never alert data.
# ARDEA_LICENSE_KEY=
# If the worker reaches the internet only through the egress proxy: http://egress-proxy:3128
# (empty = EGRESS_PROXY, or direct). Without internet access ask for an offline licence file.
# ARDEA_LICENSE_PROXY=

# ---------------------------------------------------------------- SIEM
# ONE Elastic cluster: fill in below. SEVERAL clusters: use siems/siems.json instead
# (see siems/siems.example.json and README "Several SIEMs"); it overrides the settings below.
# Shown in the UI and notifications
# SIEM_NAME=Elastic
# Two read-only keys (see elastic/roles.json)
# ELASTIC_URL=YOUR_ELASTICSEARCH_URL
# ELASTIC_FETCHER_API_KEY=YOUR_FETCHER_KEY
# ELASTIC_WORKER_API_KEY=YOUR_WORKER_KEY
# Optional: path to a CA bundle inside the container
# ELASTIC_CA_CERT=
# The UI only links to this host
# KIBANA_BASE_URL=YOUR_KIBANA_URL

# ---------------------------------------------------------------- Web search (README: "Enabling web search safely")
# brave | searxng | google_cse (ends 2027-01-01) | disabled
# WEB_SEARCH_PROVIDER=disabled
# BRAVE_API_KEY=
# Self-hosted SearXNG (free, no key): WEB_SEARCH_PROVIDER=searxng, SEARXNG_URL=http://searxng:8080
# SEARXNG_URL=
# Random string, e.g.: openssl rand -hex 32
SEARXNG_SECRET=
# Optional containers started by every plain `docker compose up`: search = SearXNG, egress = squid proxy (Brave)
#COMPOSE_PROFILES=search
# http://egress-proxy:3128 with: docker compose --profile egress up -d
EGRESS_PROXY=
# Every internal DNS suffix / AD domain FQDN
# INTERNAL_DOMAINS=yourcompany.com,local,lan,corp
# Comma list: company / M365 tenant name, AD NetBIOS name, customer names, project and app names
# SENSITIVE_TERMS=
# Log queries to outbound_requests but send nothing. Review them before setting false.
# WEB_SEARCH_DRY_RUN=true
# Add command_pattern,error_text (free text) only after a clean dry run
# WEB_SEARCH_KINDS=ip,domain,hash,cve,mitre,filename
WEB_SEARCH_PER_HOUR=60
WEB_SEARCH_PER_DAY=500

# Docker subnets used by egress-proxy/firewall.sh. Change only if they collide with your LAN.
ARDEA_LAN_SUBNET=172.30.10.0/24
ARDEA_EGRESS_SUBNET=172.30.20.0/24

# ---------------------------------------------------------------- Notifications (README: "True Positive notifications")
# smtp, ntfy, slack, teams, webhook, jira, thehive (comma list). Empty = off. Pro / MSP.
# NOTIFY_CHANNELS=
# Comma list, e.g. True Positive,Needs Human Review (then NOTIFY_MIN_SEVERITY=High is sensible)
# NOTIFY_VERDICTS=True Positive
# NOTIFY_MIN_SEVERITY=Informational
# full, or minimal = verdict, severity, rule and links only (no host/user/summary)
# NOTIFY_DETAIL=full
# Link in messages, e.g. https://ardea.yourcompany.com
# ARDEA_PUBLIC_URL=
# SMTP_HOST=
# SMTP_PORT=587
# starttls | ssl | none (none only for an internal relay)
# SMTP_SECURITY=starttls
# SMTP_USER=
# Use SINGLE quotes if it contains $ or #
# SMTP_PASSWORD=
# SMTP_FROM=
# Comma list
# SMTP_TO=
# Public ntfy.sh, or your self-hosted ntfy (keeps alert details on your network)
# NTFY_URL=https://ntfy.sh
# On public ntfy.sh make it long and random: the topic name is the password
# NTFY_TOPIC=
# NTFY_TOKEN=
# http://egress-proxy:3128 when using ntfy.sh behind the egress lockdown
NTFY_PROXY=

# ---------------------------------------------------------------- Integrations (Pro; README "Integrations")
# Add slack, teams, webhook, jira and/or thehive to NOTIFY_CHANNELS above, then fill in what you use.
# Proxy for these HTTP channels, e.g. http://egress-proxy:3128 (empty = direct)
# NOTIFY_PROXY=
# Slack: an incoming webhook URL. Teams: a Workflows "Post to a channel when a webhook request is received" URL.
# SLACK_WEBHOOK_URL=
# TEAMS_WEBHOOK_URL=
# Any HTTPS endpoint; with a secret, each request carries X-Ardea-Signature: sha256=<HMAC of the body>
# WEBHOOK_URL=
# WEBHOOK_SECRET=
# Jira Cloud: one issue per notified verdict
# JIRA_URL=
# JIRA_USER=
# JIRA_API_TOKEN=
# JIRA_PROJECT=
# JIRA_ISSUE_TYPE=Task
# TheHive 5: one alert per notified verdict
# THEHIVE_URL=
# THEHIVE_API_KEY=

# ---------------------------------------------------------------- Reports (Pro; README "Reports and insights")
# off | weekly | monthly. E-mailed through the SMTP settings above.
# ARDEA_REPORTS=off
# Comma list; empty = SMTP_TO
# ARDEA_REPORT_TO=
# Analyst minutes one alert would take; used for the "time saved" estimate
# ARDEA_MINUTES_PER_ALERT=10

# ---------------------------------------------------------------- Web UI (HTTPS and login)
# Extra public addresses the UI is opened at, e.g. through a firewall port forward that changes the port:
# ALLOWED_ORIGINS=https://ardea.example.com:8443
ALLOWED_ORIGINS=
# How users reach Ardea, comma-separated: host names and/or IP addresses, e.g. ardea.example.com, 192.168.1.20
ARDEA_SITE_ADDRESS=localhost
# If users open Ardea by IP address, put that IP here (browsers send no host name for IPs).
ARDEA_DEFAULT_SNI=localhost
# internal = Caddy creates its own certificate (install its root certificate on analyst machines, see README).
# Your own certificate: put ardea.crt and ardea.key in caddy/certs and set
# ARDEA_TLS=/certs/ardea.crt /certs/ardea.key
ARDEA_TLS=internal
# Ports on the Docker host. Port 80 only redirects to HTTPS.
ARDEA_HTTPS_BIND=443
ARDEA_HTTP_BIND=80
# HSTS: keep 0 with the internal certificate. With a trusted certificate, e.g. 31536000 (one year).
ARDEA_HSTS_SECONDS=0
# Sessions end after this many minutes without activity, and always after SESSION_MAX_HOURS.
SESSION_IDLE_MINUTES=480
SESSION_MAX_HOURS=24
# Wrong passwords before an account is locked, and for how long.
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
# Pro / MSP: sign in through your identity provider (Authentik, Authelia, ...). Also uncomment
# forward_auth in caddy/Caddyfile. Users must exist in Ardea with the same username.
ARDEA_SSO=false
# MSP: your own product name in the UI; put a logo in branding/logo.png (or .jpg / .webp, max 512 KB)
# ARDEA_BRAND_NAME=
